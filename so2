
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VELORA Aim Lab</title>
<style>
body {
  background: #100d1c;
  color: white;
  font-family: system-ui;
  text-align: center;
  padding: 20px;
}
h1 { color: #c084fc; }
#arena {
  height: 65vh;
  min-height: 300px;
  position: relative;
  background: #201833;
  border: 2px solid #a855f7;
  border-radius: 16px;
  overflow: hidden;
}
#target {
  position: absolute;
  width: 42px;
  height: 42px;
  border: 3px solid #f472b6;
  border-radius: 50%;
  background: #a855f755;
  transform: translate(-50%, -50%);
  touch-action: manipulation;
}
</style>
</head>
<body>
<h1>VELORA</h1>
<p>Offline Aim Lab</p>
<div id="arena">
  <button id="target" aria-label="Hedef"></button>
</div>
<p>İsabet: <span id="score">0</span></p>
<script>
const arena = document.querySelector("#arena");
const target = document.querySelector("#target");
const score = document.querySelector("#score");
let hits = 0;

function moveTarget() {
  target.style.left = (10 + Math.random() * 80) + "%";
  target.style.top = (10 + Math.random() * 80) + "%";
}

target.addEventListener("click", () => {
  hits++;
  score.textContent = hits;
  moveTarget();
});

moveTarget();
</script>
</body>
</html>
